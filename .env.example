# ==============================================================================
# DALMO & JADI — VARIÁVEIS DE AMBIENTE (.env.example)
# Nunca exponha tokens secretos com prefixo VITE_* ou no frontend.
# Pix direto funciona sem chaves de servidor extras (usa site_settings/main).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OBRIGATÓRIAS PARA PUBLICAÇÃO DO CARTÃO (MERCADO PAGO)
# ------------------------------------------------------------------------------
# Credenciais de Produção (APP_USR-...) ou Testes (TEST-...) da mesma conta:
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Assinatura secreta de Webhooks (Mercado Pago Developers -> Webhooks):
MERCADOPAGO_WEBHOOK_SECRET=""

# Nota: APP_URL é fornecida automaticamente pelo ambiente Google AI Studio / Cloud Run.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. OPCIONAIS (RECURSOS COMPLEMENTARES E CONTINGÊNCIA)
# ------------------------------------------------------------------------------
# Sobrescrita opcional de domínio customizado para exibição da URL de Webhook:
PUBLIC_APP_URL=""

# Fallback opcional de Public Key no build estático (SOMENTE Public Key, nunca Access Token):
VITE_MERCADOPAGO_PUBLIC_KEY=""

# Fallback opcional apenas se o runtime Cloud Run não possuir IAM roles/datastore.user via ADC:
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Integração opcional de webhook para provedor Pix externo (não exigida pelo Pix direto):
PIX_WEBHOOK_SECRET=""

# E-mails adicionais autorizados no painel administrativo (separados por vírgula):
ADMIN_ALLOWED_EMAILS=""

# Integração GitHub App para persistência de mídias da Galeria 3D e Cerimônia:
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_MEDIA_OWNER="dalmofilho38-cyber"
GITHUB_MEDIA_REPO="App-Casamento-Dalmo-e-Jadi"
GITHUB_MEDIA_BRANCH="main"
# Alternativa opcional caso não use GitHub App (Fine-grained PAT com Contents Read/Write):
GITHUB_MEDIA_TOKEN=""

# Busca complementar de fotos de presentes no painel admin (Wikimedia/Openverse funcionam sem chave):
SERPAPI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. VARIÁVEIS OBSOLETAS / REMOVIDAS (NÃO SÃO MAIS UTILIZADAS PELO CÓDIGO)
# ------------------------------------------------------------------------------
# As variáveis abaixo não possuem uso no projeto atual e não devem ser solicitadas:
# - GEMINI_API_KEY
# - PEXELS_API_KEY
# - UNSPLASH_ACCESS_KEY
# - PIXABAY_API_KEY
# - BRAVE_SEARCH_API_KEY
